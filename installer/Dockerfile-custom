FROM 1panel/maxkb:latest

# Install our extra Python deps
RUN pip3 install --target=/opt/py3/lib/python3.11/site-packages \
    channels==4.3.2 channels-redis==4.3.0 zhipuai -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

# Fix missing files
RUN mkdir -p /opt/maxkb-app/tmp && mkdir -p /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/credential && mkdir -p /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/model && \
    echo -e "class TencentSTTModel: pass\nclass TencentSpeechToText: pass" > /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/model/stt.py && \
    echo -e "from common.forms import BaseForm\nclass TencentSTTModelCredential(BaseForm): pass" > /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/credential/stt.py

# Copy our code (overwrites the official one)
COPY apps/ /opt/maxkb-app/apps/
COPY ui/dist/admin /opt/maxkb-app/ui/dist/admin
COPY ui/dist/chat /opt/maxkb-app/ui/dist/chat
