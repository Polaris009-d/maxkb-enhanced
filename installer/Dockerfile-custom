FROM 1panel/maxkb:latest
RUN pip3 install --target=/opt/py3/lib/python3.11/site-packages \
    channels==4.3.2 channels-redis==4.3.0 zhipuai -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN mkdir -p /opt/maxkb-app/tmp \
    /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/credential \
    /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/model \
    /opt/maxkb-app/apps/models_provider/impl/azure_model_provider/icon \
    /opt/maxkb-app/apps/models_provider/impl/wenxin_model_provider/icon \
    /opt/maxkb-app/apps/models_provider/impl/kimi_model_provider/icon \
    /opt/maxkb-app/apps/models_provider/impl/minimax_model_provider/icon \
    /opt/maxkb-app/apps/models_provider/impl/regolo_model_provider/icon && \
    touch /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/credential/stt.py && \
    echo -e "class TencentSTTModel: pass\nclass TencentSpeechToText: pass" > /opt/maxkb-app/apps/models_provider/impl/tencent_model_provider/model/stt.py
COPY ui/dist/admin /opt/maxkb-app/ui/dist/admin
# Copy all provider icon files
COPY apps/models_provider/impl/ /opt/maxkb-app/apps/models_provider/impl/
